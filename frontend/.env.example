# Ken Finance frontend configuration
# Copy to .env — Expo exposes only EXPO_PUBLIC_* variables to the app.

# Express API. On the Android emulator, 10.0.2.2 is the alias for the host
# machine's loopback; plain localhost resolves to the emulator itself. On a
# physical device use the host's LAN address, e.g. http://192.168.1.5:5000
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Set to 'true' to disable the paid LLM categorisation tier client-side.
EXPO_PUBLIC_DISABLE_LLM=false

# Supabase sync. Leave blank to run fully offline — the app works without it.
# Create a project, run supabase/schema.sql in the SQL editor, then paste
# Project Settings → API → Project URL and anon/public key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
